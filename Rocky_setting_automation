import paramiko
import sys
import time

def show_menu():
    res = int(input(""" 
    실행할 작업의 번호 선택하세요.
    1. 방화벽 해제
    2. 패키지 업데이트
    3. 패키지 세팅(wget, vim, libstdc++, tar, gzip)
    4. 미니콘다 설치
    5. 주피터 노트북 실행 설정
    6. systempython, 파라미코 설치
    0. 종료
    선택: """))
    return res

def ssh(ip, user, pw):
    cli = paramiko.SSHClient()                                      
    cli.set_missing_host_key_policy(paramiko.AutoAddPolicy())       
    print("[%s] 서버에 연결 중..." % ip)
    cli.connect(ip, username=user, password=pw, port=22)            

    while True:
        cmd = show_menu()
        if cmd == 0:
            print("프로그램을 종료합니다.")
            cli.close()
            break
            
        for i in cmd_dict[cmd]:
            print("-> 실행 중: %s" % i)
            
            # init 6(재부팅)이 실행되면 SSH 연결이 끊어지므로 예외 처리
            if i == "init 6":
                print("시스템을 재부팅합니다. 연결이 끊어집니다.")
                cli.exec_command(i)
                time.sleep(2) # 재부팅 명령어 전달될 시간 부여
                break

            (stdin, stdout, stderr) = cli.exec_command(i)
            
            # 주의: stdout을 read()로 한 번 읽었으면, 다시 readlines()로 읽을 수 없습니다.
            output = stdout.read().decode('utf-8').strip()
            error = stderr.read().decode('utf-8').strip()
            
            if error:
                print("[알림/에러] %s" % error)
                # 리눅스는 정상 작동해도 경고를 stderr로 보내는 경우가 많아 sys.exit()은 주석 처리하는 것이 좋습니다.
                
            if output:
                print("[결과] %s" % output)

    cli.close()

