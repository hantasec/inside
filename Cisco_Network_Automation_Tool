# 주의사항
# 파일의 각 줄은 반드시 아래 형식으로 작성할 것
# 목적지네트워크 서브넷마스크 다음홉IP

# 예시
# 172.16.0.0 255.255.0.0 192.168.1.1
# 192.168.10.0 255.255.255.0 192.168.1.254

def route_setting():
   
    name = input("라우트 세팅파일 명을 입력해 주세요. (txt제외) : ")
    path_route = "../../router/test/%s.txt"%(name)
    command = ""

    with open(path_route, 'r') as f:
        lines = f.readlines()
        
        for route in lines :
            route = route.strip()
            
            if not route:
                continue
            
            command += "ip route " + route + "\n"
            
        print("설정된 값\n" + command)
        
        manage_cisco_device(command)

